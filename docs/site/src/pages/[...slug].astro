---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import { buildNavLinks, cleanPath, EXCLUDED_DOCS, extractDescription } from "../utils/routing";

export async function getStaticPaths() {
  const rootDocs = import.meta.glob("../../../../*.md", { eager: true });
  const adrDocs = import.meta.glob("../../../../docs/adr/*.md", { eager: true });
  const guideDocs = import.meta.glob("../../../../docs/guides/*.md", { eager: true });

  const allFiles: Record<string, any> = Object.fromEntries(
    Object.entries({ ...rootDocs, ...adrDocs, ...guideDocs }).filter(([key]) => {
      const relativePath = cleanPath(key).toLowerCase();
      const excluded = EXCLUDED_DOCS.some((doc) => key.toLowerCase().endsWith(doc));
      return !excluded && relativePath !== "index";
    })
  );

  const allKeys = Object.keys(allFiles);
  const navLinks = buildNavLinks(allKeys);

  return Object.entries(allFiles).map(([key, doc]) => {
    const slug = cleanPath(key).toLowerCase();
    return { params: { slug }, props: { doc, navLinks } };
  });
}

const { doc, navLinks } = Astro.props;
const Content = doc.default;

const currentSlug = (Astro.params.slug || "").toLowerCase();

const isAnyAdrActive = currentSlug.startsWith("adr/");
const isAnyGuideActive = currentSlug.startsWith("guides/");
const docLinks = navLinks.filter((link) => !link.isAdr && !link.isGuide && link.path !== "changelog");
const guideLinks = navLinks.filter((link) => link.isGuide);
const adrLinks = navLinks.filter((link) => link.isAdr);
const changelogLink = navLinks.find((link) => link.path === "changelog");

const pageTitle = doc.frontmatter?.title || currentSlug;
const description = doc.frontmatter?.description || extractDescription(doc.rawContent());

// pagination: ordered walk of the same nav links
const ordered = [
  ...docLinks,
  ...guideLinks,
  ...adrLinks,
  ...(changelogLink ? [changelogLink] : []),
];
const idx = ordered.findIndex((l) => l.path === currentSlug);
const prev = idx > 0 ? ordered[idx - 1] : undefined;
const next = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : undefined;

const kicker = currentSlug.startsWith("guides/")
  ? "Guides"
  : currentSlug.startsWith("adr/")
    ? "Architecture decision"
    : currentSlug === "changelog"
      ? "Releases"
      : "Documentation";
---

<Layout title={pageTitle} description={description}>
  <div class="shell-stage relative min-h-dvh">
    <div class="rail rail--left" aria-hidden="true"></div>
    <div class="rail rail--right" aria-hidden="true"></div>

    <Sidebar
      currentSlug={currentSlug}
      docLinks={docLinks}
      guideLinks={guideLinks}
      adrLinks={adrLinks}
      changelogLink={changelogLink}
      isAnyGuideActive={isAnyGuideActive}
      isAnyAdrActive={isAnyAdrActive}
    />

    <main class="relative z-10 lg:ml-64">
      <div class="mx-auto w-full max-w-3xl px-5 pb-24 pt-10 sm:px-8 xl:max-w-[72rem] xl:flex xl:items-start xl:gap-10">
        <div class="min-w-0 flex-1 xl:mr-auto">
          <header class="page-hero reveal">
          <p class="page-hero__kicker">{kicker}</p>
          <h1>{doc.frontmatter?.title || pageTitle}</h1>
          {description && <p>{description}</p>}
        </header>

        <article class="docs-prose">
          <Content />
        </article>

        <nav class="pager" aria-label="Pagination">
          {prev ? (
            <a href={`/${prev.path}/`}>
              <span class="pager__dir">← Previous</span>
              <span class="pager__title block">{prev.title}</span>
            </a>
          ) : (
            <a href="/">
              <span class="pager__dir">← Back</span>
              <span class="pager__title block">Home</span>
            </a>
          )}
          {next && (
            <a href={`/${next.path}/`}>
              <span class="pager__dir">Next →</span>
              <span class="pager__title block">{next.title}</span>
            </a>
          )}
        </nav>
        </div>

        <aside class="toc hidden xl:block" data-toc aria-label="On this page"></aside>
      </div>
    </main>
  </div>
</Layout>

<script>
  // Copy button on every code block
  document.querySelectorAll<HTMLPreElement>(".docs-prose pre").forEach((pre) => {
    const codeEl = pre.querySelector("code");
    if (!codeEl) return;
    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy code to clipboard");
    button.addEventListener("click", async () => {
      const text = codeEl.textContent || "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      button.textContent = "Copied";
      button.classList.add("is-copied");
      setTimeout(() => {
        button.textContent = "Copy";
        button.classList.remove("is-copied");
      }, 1600);
    });
    pre.appendChild(button);
  });

  // ---- Hero reveal (docs pages) ----
  const revealEls = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
  if (revealEls.length > 0) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.06 }
    );
    for (const el of revealEls) {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight * 1.15) {
        el.classList.add("is-in");
      } else {
        io.observe(el);
      }
    }
  }

  // ---- On-this-page TOC: fills the rail column, scroll-spies sections ----
  const tocEl = document.querySelector<HTMLElement>("[data-toc]");
  const article = document.querySelector<HTMLElement>("article.docs-prose");
  if (tocEl && article) {
    const heads = [...article.querySelectorAll<HTMLHeadingElement>("h2, h3")];
    if (heads.length > 0) {
      tocEl.innerHTML = `<p class="toc__label">On this page</p>`;
      const list = document.createElement("ul");
      list.className = "toc__list";
      heads.forEach((h, i) => {
        if (!h.id) h.id = `section-${i}`;
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${h.id}`;
        a.textContent = h.textContent || "";
        a.dataset.tocLink = h.id;
        if (h.tagName === "H3") a.classList.add("toc__sub");
        li.appendChild(a);
        list.appendChild(li);
      });
      tocEl.appendChild(list);

      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              tocEl.querySelectorAll("[data-toc-link]").forEach((l) => l.classList.remove("is-active"));
              tocEl.querySelector(`[data-toc-link="${CSS.escape(e.target.id)}"]`)?.classList.add("is-active");
            }
          }
        },
        { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
      );
      heads.forEach((h) => spy.observe(h));
    }
  }
</script>
