---
import Layout from "../layouts/Layout.astro";
import Topbar from "../components/Topbar.astro";
import { GITHUB_URL } from "../utils/routing";
---

<Layout
  title="404: Page Not Found"
  description="The page you're looking for doesn't exist. Head back to the Skill Eval documentation homepage to find what you need."
  noindex={true}
>
  <div class="shell-stage relative flex min-h-dvh flex-col">
    <div class="rail rail--left" aria-hidden="true"></div>
    <div class="rail rail--right" aria-hidden="true"></div>

    <Topbar />

    <main class="relative z-10 flex flex-1 items-center justify-center px-5 py-24">
      <div class="w-full max-w-2xl text-center">
        <p class="mb-6 font-mono text-[0.6875rem] uppercase tracking-[0.2em] text-[var(--color-ink-faint)]">
          <span class="text-[var(--color-danger)]">error</span> · eval not found
        </p>
        <h1 class="font-display text-[clamp(4.5rem,16vw,8.5rem)] font-bold leading-none tracking-[-0.04em] text-[var(--color-ink)]">
          4<span class="text-[var(--color-accent)]">0</span>4
        </h1>
        <p class="mx-auto mt-6 max-w-md text-lg leading-relaxed text-[var(--color-ink-dim)]">
          This route doesn't exist. The assertion failed — and like any good eval, it's time
          to check the baseline.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-accent)] px-5 py-3 text-sm font-semibold text-[#05281a] transition-all hover:bg-[#52e6a4]"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M11 18l-6-6 6-6" />
            </svg>
            Back to Home
          </a>
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-xl border border-[var(--color-line-bright)] bg-white/[0.03] px-5 py-3 text-sm font-medium text-[var(--color-ink)] transition-colors hover:border-[var(--color-accent)]/50"
          >
            Report it on GitHub
          </a>
        </div>
      </div>
    </main>
  </div>
</Layout>
