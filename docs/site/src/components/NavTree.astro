---
import { GITHUB_URL } from "../utils/routing";

interface NavLink {
  path: string;
  title: string;
  isAdr: boolean;
  isGuide: boolean;
}

interface Props {
  currentSlug: string;
  docLinks: NavLink[];
  guideLinks: NavLink[];
  adrLinks: NavLink[];
  changelogLink?: NavLink;
  isAnyGuideActive: boolean;
  isAnyAdrActive: boolean;
}

const {
  currentSlug,
  docLinks,
  guideLinks,
  adrLinks,
  changelogLink,
  isAnyGuideActive,
  isAnyAdrActive,
} = Astro.props;

function classes(active: boolean) {
  return `navlink${active ? " is-active" : ""}`;
}

function dot(active: boolean, tone: string) {
  return active ? `navlink__dot navlink__dot--${tone}` : "navlink__dot";
}
---

<nav class="docs-sidebar" aria-label="Documentation">
  <div class="navgroup">
    <p class="navgroup__label">Start here</p>
    <a href="/" class={classes(currentSlug === "")} aria-current={currentSlug === "" ? "page" : undefined}>
      <span class={dot(currentSlug === "", "accent")}></span>
      <span>Home</span>
    </a>
  </div>

  <div class="navgroup">
    <p class="navgroup__label">Documentation</p>
    <ul class="space-y-0.5" role="list">
      {docLinks.map((link) => (
        <li>
          <a href={`/${link.path}/`} class={classes(link.path === currentSlug)} aria-current={link.path === currentSlug ? "page" : undefined}>
            <span class={dot(link.path === currentSlug, "accent")}></span>
            <span class="truncate">{link.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="navgroup" data-open={isAnyGuideActive ? "true" : undefined}>
    <p class="navgroup__label">Guides</p>
    <ul class="space-y-0.5" role="list">
      {guideLinks.map((link) => (
        <li>
          <a href={`/${link.path}/`} class={classes(link.path === currentSlug)} aria-current={link.path === currentSlug ? "page" : undefined}>
            <span class={dot(link.path === currentSlug, "info")}></span>
            <span class="truncate">{link.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="navgroup" data-open={isAnyAdrActive ? "true" : undefined}>
    <p class="navgroup__label">Architecture</p>
    <ul class="space-y-0.5" role="list">
      {adrLinks.map((link) => (
        <li>
          <a href={`/${link.path}/`} class={classes(link.path === currentSlug)} aria-current={link.path === currentSlug ? "page" : undefined}>
            <span class={dot(link.path === currentSlug, "accent")}></span>
            <span class="truncate">{link.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="navgroup">
    <p class="navgroup__label">Releases</p>
    {changelogLink && (
      <ul class="space-y-0.5" role="list">
        <li>
          <a href={`/${changelogLink.path}/`} class={classes(changelogLink.path === currentSlug)} aria-current={changelogLink.path === currentSlug ? "page" : undefined}>
            <span class={dot(changelogLink.path === currentSlug, "warn")}></span>
            <span class="truncate">{changelogLink.title}</span>
          </a>
        </li>
      </ul>
    )}
    <a
      href={GITHUB_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="navlink mt-3 border border-solid border-[var(--color-line)]"
    >
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      <span>GitHub</span>
    </a>
  </div>
</nav>
