---
import { GITHUB_URL } from "../utils/routing";
---

<header class="topbar">
  <button
    id="menu-toggle"
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
    class="mr-3 -ml-1 grid size-10 place-items-center rounded-lg border border-[var(--color-line)] bg-white/[0.03] text-[var(--color-ink-dim)] transition-colors hover:text-[var(--color-ink)] lg:hidden"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </button>

  <a href="/" class="brandmark group">
    <span class="brandmark__glyph" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
        <path d="M8 1.5 9.9 6.1 14.5 8 9.9 9.9 8 14.5 6.1 9.9 1.5 8 6.1 6.1 8 1.5Z" stroke="#3ddc97" stroke-width="1.4" stroke-linejoin="round" />
      </svg>
    </span>
    <span class="brandmark__word hidden sm:block">skill-eval</span>
  </a>

  <div class="ml-auto flex items-center gap-2">
    <span class="chip chip--accent hidden md:inline-flex">
      <span class="size-1.5 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
      v1.5.0
    </span>
    <a
      href={GITHUB_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-line-bright)] bg-white/[0.03] px-3 py-2 text-xs font-medium text-[var(--color-ink-dim)] transition-colors hover:border-[var(--color-accent)]/40 hover:text-[var(--color-ink)]"
    >
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      <span class="hidden sm:inline">GitHub</span>
    </a>
  </div>

  <div class="progress" id="scroll-progress" aria-hidden="true"></div>
</header>
